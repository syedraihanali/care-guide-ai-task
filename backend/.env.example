# Backend configuration. Every value is optional: a missing or empty value uses the default shown here.
# To change something, copy this file to .env (next to it) and edit only what you need.

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/api_monitor
# Allowed browser origins, comma-separated.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Alert text. Leave OPENAI_API_KEY empty to use template alerts (no LLM calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
LLM_BATCH_SIZE=20

# Monitoring
AUTO_RESOLVE_ON_RECOVERY=true
MAX_BATCH_SIZE=1000

# Email reports
EMAIL_ENABLED=false
EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
